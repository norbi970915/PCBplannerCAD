{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PCBPlanner Studio",
  "mainBinaryName": "PCBPlannerStudio",
  "version": "0.6.6",
  "identifier": "com.pcbplanner.studio",
  "build": {
    "beforeDevCommand": "pnpm legal:prepare && pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm legal:prepare && pnpm vite build && pnpm legal:verify --dist",
    "frontendDist": "../dist",
    "beforeBundleCommand": "pnpm installers:verify && pnpm legal:prepare && pnpm legal:verify --dist"
  },
  "app": {
    "windows": [
      {
        "title": "PCBPlanner Studio",
        "width": 1600,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "backgroundColor": "#1b1c1f",
        "create": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "PCB design suite",
    "fileAssociations": [
      {
        "ext": [
          "arpcb"
        ],
        "name": "PCBPlanner Studio PCB",
        "description": "PCBPlanner Studio PCB document",
        "role": "Editor"
      }
    ],
    "publisher": "Buchmüller Norbert",
    "copyright": "Copyright © 2026 Buchmüller Norbert. All rights reserved.",
    "homepage": "https://www.pcbplanner.com",
    "licenseFile": "../../LICENSE.md",
    "resources": {
      "../../LICENSE/": "legal/"
    },
    "windows": {
      "nsis": {
        "template": "installers/setup.nsi",
        "installerHooks": "installers/shortcut-icons.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "template": "installers/setup.wxs"
      }
    }
  }
}
