{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pCAD",
  "mainBinaryName": "pCAD",
  "version": "0.6.0",
  "identifier": "eu.allengra.pcbplannercad",
  "build": {
    "beforeDevCommand": "pnpm vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "pCAD",
        "width": 1600,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true,
        "backgroundColor": "#1b1c1f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "PCB design suite",
    "fileAssociations": [
      { "ext": ["arpcb"], "name": "pCAD PCB", "description": "pCAD PCB document", "role": "Editor" }
    ]
  }
}
